---
// Cabeçalho fixo: wordmark, menu em pílula, CTA "Avise-me" (leva à página do produto) e menu mobile (hambúrguer).
// Os links viram props, então o mesmo componente serve para outras páginas.
// Estilos compartilhados (.wordmark, .mono) e os tokens (:root) ficam no CSS global da página.
import Button from './Button.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links?: NavLink[];
  ctaHref?: string;
  ctaLabel?: string;
  ctaIcon?: 'arrow-up-right' | 'bell';
}

const {
  links = [
    { href: '#hero', label: 'Design' },
    { href: '#ponta', label: 'Ponta 0.1' },
    { href: '#tinta', label: 'Tinta' },
    { href: '#especificacoes', label: 'Especificações' },
    { href: '/galeria', label: 'Galeria' },
  ],
  ctaHref = '/produto',          // a caneta está esgotada: o CTA leva à página do produto (lista de espera)
  ctaLabel = 'Avise-me',
  ctaIcon = 'bell',
} = Astro.props;

// As âncoras (#ponta, #tinta…) existem só na página inicial.
// Nas outras páginas, "#ponta" vira "/#ponta": abre a home já na seção certa.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/' || path === '/index.html';
const toHref = (href: string) => (href.startsWith('#') && !isHome ? `/${href}` : href);
// Item ativo: na home, a primeira seção (o scroll atualiza depois); nas outras, o link da própria página.
const isCurrent = (href: string, i: number) => (href.startsWith('#') ? isHome && i === 0 : path === href);
---

<header class="nav" id="nav" data-home={isHome ? 'true' : 'false'}>
  <div class="nav-inner">
    <a class="wordmark" href={toHref('#hero')} aria-label="ARTOOLS — início">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="2.5"/></svg>
      ARTOOLS
    </a>

    <nav class="pill-menu" aria-label="Seções do produto" id="pillMenu">
      <span class="pill-indicator" aria-hidden="true"></span>
      {links.map((link, i) => (
        <a href={toHref(link.href)} aria-current={isCurrent(link.href, i) ? 'true' : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <Button href={toHref(ctaHref)} icon={ctaIcon} data-cta>{ctaLabel}</Button>
      <button class="burger" id="burger" aria-expanded="false" aria-controls="mobileMenu" aria-label="Abrir menu">
        <span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-label="Menu" role="dialog">
  {links.map((link, i) => (
    <a href={toHref(link.href)}>{link.label} <span class="mono">{String(i + 1).padStart(2, '0')}</span></a>
  ))}
  <div class="mobile-cta">
    <Button href={toHref(ctaHref)} icon={ctaIcon} data-cta>{ctaLabel}</Button>
  </div>
</div>

<style>
  /* Estilos com escopo: o Astro aplica só aos elementos deste componente. */
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--nav-h);
    opacity: 0; transform: translateY(-10px);                 /* .nav-load (a página adiciona .loaded) */
    transition: opacity var(--dur-in) ease-out, transform var(--dur-in) ease-out;
  }
  .nav.loaded { opacity: 1; transform: none; }
  .nav::before { /* fundo de vidro — aparece quando o conteúdo passa por baixo (a página adiciona .solid) */
    content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0; pointer-events: none;
    background: rgba(234, 234, 229, .85); backdrop-filter: blur(var(--blur-glass)); -webkit-backdrop-filter: blur(var(--blur-glass));
    border-bottom: 1px solid var(--pedra-300); transition: opacity var(--dur-base) var(--ease-architect);
  }
  .nav.solid::before { opacity: 1; }
  .nav-inner {
    max-width: 1400px; height: 100%; margin: 0 auto; padding: 0 var(--gutter);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-4);
  }

  /* Menu pílula */
  .pill-menu {
    position: relative; display: flex; gap: 2px; padding: 5px;
    border: 1px solid var(--pedra-300); border-radius: var(--radius-full);
    background: var(--branco-55);
    backdrop-filter: blur(var(--blur-glass)) saturate(1.2); -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(1.2);
  }
  .pill-menu a { position: relative; z-index: 1; padding: 10px 18px; border-radius: var(--radius-full); font-size: .875rem; font-weight: 500; color: var(--grafite-80); transition: color var(--dur-base) var(--ease-architect); }
  .pill-menu a:hover { color: var(--tinta); }
  .pill-menu a[aria-current="true"] { color: var(--branco); }
  .pill-indicator { position: absolute; z-index: 0; top: 5px; bottom: 5px; left: 0; width: 0; border-radius: var(--radius-full); background: var(--grafite); transition: transform var(--dur-base) var(--ease-architect), width var(--dur-base) var(--ease-architect); }
  .pill-indicator::after { content: ""; position: absolute; left: 50%; bottom: 4px; width: 4px; height: 4px; margin-left: -2px; border-radius: var(--radius-full); background: var(--lume); box-shadow: var(--shadow-lume); }

  .nav-actions { justify-self: end; display: flex; align-items: center; gap: var(--s-3); }

  /* Hambúrguer + menu mobile */
  .burger { display: none; width: 44px; height: 44px; border-radius: var(--radius-full); border: 1px solid var(--pedra-300); background: var(--branco-55); backdrop-filter: blur(var(--blur-backdrop)); -webkit-backdrop-filter: blur(var(--blur-backdrop)); place-items: center; }
  .burger > span { display: block; width: 16px; }   /* só agrupa as duas linhas */
  .burger > span > span { display: block; width: 16px; height: 1.5px; background: var(--tinta); transition: transform var(--dur-base) var(--ease-architect); }
  .burger > span > span + span { margin-top: 5px; }
  .burger[aria-expanded="true"] > span > span:first-child { transform: translateY(3.25px) rotate(45deg); }
  .burger[aria-expanded="true"] > span > span:last-child { transform: translateY(-3.25px) rotate(-45deg); }
  .mobile-menu {
    position: fixed; z-index: 49; left: 12px; right: 12px; top: calc(var(--nav-h) - 4px);
    padding: var(--s-4); border: 1px solid var(--pedra-300); border-radius: var(--radius-xl);
    background: var(--branco-60); backdrop-filter: blur(var(--blur-glass)) saturate(1.2); -webkit-backdrop-filter: blur(var(--blur-glass)) saturate(1.2);
    opacity: 0; transform: translateY(-8px); filter: blur(6px); visibility: hidden;
    transition: all var(--dur-base) var(--ease-architect);
  }
  .mobile-menu.open { opacity: 1; transform: none; filter: none; visibility: visible; }
  .mobile-menu > a { display: flex; justify-content: space-between; align-items: center; padding: var(--s-4) var(--s-2); border-bottom: 1px solid var(--pedra-300); font-size: 1.125rem; font-weight: 500; letter-spacing: var(--tracking-tight); }
  .mobile-menu > a:last-of-type { border-bottom: 0; }
  .mobile-menu .mono { color: var(--grafite-80); }
  .mobile-cta { padding-top: var(--s-4); }
  /* :global() alcança o botão, que pertence ao componente Button */
  .mobile-cta :global(.btn-primary) { width: 100%; justify-content: space-between; }

  @media (max-width: 1100px) {
    .pill-menu a { padding: 10px 12px; font-size: .8125rem; }
  }
  @media (max-width: 900px) and (min-width: 769px) {
    .pill-menu { display: none; }
    .nav-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    .nav-inner { grid-template-columns: 1fr auto; }
    .pill-menu, .nav-actions :global(.btn-primary) { display: none; }
    .burger { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav { opacity: 1; transform: none; }
  }
</style>

<!--
  is:inline: o script roda exatamente aqui, antes do script principal da página
  (que usa window.__setNav). O bloco { } isola as variáveis para não colidirem
  com as do script da página.
-->
<script is:inline>
{
  const menu = document.getElementById('pillMenu');
  const ind = menu.querySelector('.pill-indicator');
  const links = [...menu.querySelectorAll('a')];

  // Indicador escuro que desliza até o item ativo / sob o mouse
  const move = (a) => { ind.style.opacity = '1'; ind.style.width = a.offsetWidth + 'px'; ind.style.transform = `translateX(${a.offsetLeft}px)`; };
  const active = () => links.find((l) => l.getAttribute('aria-current') === 'true');   // nenhum ativo fora da home
  const rest = () => { const a = active(); if (a) move(a); else ind.style.opacity = '0'; };
  const setActive = (href) => {
    const a = links.find((l) => l.getAttribute('href') === href); if (!a) return;
    links.forEach((l) => l.removeAttribute('aria-current')); a.setAttribute('aria-current', 'true'); move(a);
  };
  window.__setNav = setActive;   // a página chama ao trocar de seção no scroll

  links.forEach((a) => {
    a.addEventListener('mouseenter', () => move(a));
    a.addEventListener('focus', () => move(a));
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      const target = href.startsWith('#') && document.querySelector(href);
      if (!target) return;                      // seção em outra página (/#ponta): navegação normal
      e.preventDefault(); setActive(href);
      if (window.__lenis) window.__lenis.scrollTo(target, { duration: 1.4 });   // Lenis é criado pela página
      else target.scrollIntoView({ behavior: 'smooth' });
    });
  });
  menu.addEventListener('mouseleave', rest);
  const place = () => { ind.style.transition = 'none'; rest(); ind.offsetWidth; ind.style.transition = ''; };
  document.fonts.ready.then(place);
  addEventListener('resize', place);

  // Menu mobile (hambúrguer)
  const burger = document.getElementById('burger');
  const mm = document.getElementById('mobileMenu');
  const close = () => { burger.setAttribute('aria-expanded', 'false'); burger.setAttribute('aria-label', 'Abrir menu'); mm.classList.remove('open'); };
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open)); burger.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    mm.classList.toggle('open', open);
    if (open) mm.querySelector('a').focus();
  });
  mm.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && mm.classList.contains('open')) { close(); burger.focus(); } });

  // Entrada do cabeçalho (.nav-load) em qualquer página — dois frames garantem que a transição aconteça
  const nav = document.getElementById('nav');
  requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.add('loaded')));

  // Fundo de vidro: na home quem controla é a página (depende das dobras); nas outras, aparece ao rolar
  if (nav.dataset.home !== 'true') {
    const glass = () => nav.classList.toggle('solid', scrollY > 8);
    glass(); addEventListener('scroll', glass, { passive: true });
  }
}
</script>
